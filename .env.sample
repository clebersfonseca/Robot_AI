# ==============================================================================
# CONFIGURACAO DE AMBIENTE DO PROJETO ROBOT AI (.env.sample)
# ==============================================================================
# Copie este arquivo para ".env":
#   cp .env.sample .env
# O arquivo ".env" esta listado no .gitignore e NUNCA sera enviado ao GitHub.
# ==============================================================================

# 1. Credenciais da sua rede Wi-Fi 2.4GHz
WIFI_SSID=NOME_DO_SEU_WIFI_2.4GHZ
WIFI_PASS=SENHA_DO_SEU_WIFI

# 2. Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=SUA_CHAVE_GEMINI_AQUI

# 3. Modelos Gemini utilizados pelo Agente de Voz
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# 4. Credenciais OAuth2 da Google Agenda (TVs and limited-input devices)
# Obtenha em https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=SEU_CLIENT_ID_AQUI.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-SUA_CHAVE_SECRETA_AQUI

# Gerado por: python3 scripts/google_auth.py (nao compartilhe)
GOOGLE_REFRESH_TOKEN=
